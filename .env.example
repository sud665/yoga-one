# Copy this file to .env.local and fill in real values. Never commit .env.local
# (it is gitignored) or real secrets in this file.
#
# For local development against `npx supabase start`, run `npx supabase status`
# after starting the local stack -- it prints the local URL and anon/service_role
# keys to paste in below.

# Supabase project URL (local: http://127.0.0.1:54321; hosted: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) API key -- safe to expose to the browser, RLS enforces access control
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key -- bypasses RLS, server-only, never expose to the browser or commit it
SUPABASE_SERVICE_ROLE_KEY=

# Kakao OAuth app credentials (Kakao Developers console), used for "카카오로 로그인/가입"
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# This app's own base URL, used to build absolute links (invite URLs, OAuth/email
# redirect targets). Local dev: http://localhost:3000 (must match supabase/config.toml's
# [auth] site_url and additional_redirect_urls, or OAuth/email-confirmation redirects break).
NEXT_PUBLIC_SITE_URL=
