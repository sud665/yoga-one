# Copy this file to .env.local and fill in real values. Never commit .env.local
# (it is gitignored) or real secrets in this file.
#
# Local development: run `npx supabase start`, then `npx supabase status` prints
# every value below except the Kakao pair and the site URL.
#
# Hosted: Project Settings -> API in the Supabase dashboard.

# Supabase project URL (local: http://127.0.0.1:54321; hosted: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable API key (`sb_publishable_...`). Public by design -- it ships in the
# browser bundle and RLS is what enforces access control. `supabase status` labels
# it PUBLISHABLE_KEY; the dashboard calls it the publishable key.
#
# The legacy JWT-shaped `anon` key still works: set NEXT_PUBLIC_SUPABASE_ANON_KEY
# instead and lib/supabase/env.ts falls back to it. New setups should use this one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# service_role / secret key -- bypasses RLS entirely. Server-only: never expose it
# to the browser, never commit it. Used by tests/integration/** to seed fixtures.
SUPABASE_SERVICE_ROLE_KEY=

# Kakao OAuth app credentials (Kakao Developers console), used for "카카오로 로그인/가입"
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# This app's own base URL, used to build absolute links (invite URLs, OAuth/email
# redirect targets). Local dev: http://localhost:3000.
#
# Local: must match supabase/config.toml's [auth] site_url / additional_redirect_urls.
# Hosted: must match Authentication -> URL Configuration in the dashboard, or
# confirmation-email and OAuth redirects land on the wrong origin and silently fail.
NEXT_PUBLIC_SITE_URL=
